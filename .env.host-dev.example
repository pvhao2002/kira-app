# Dùng khi chạy app trên IntelliJ (một JVM), còn MySQL/Rabbit/nginx bằng Docker.
# Hai upstream mặc định của nginx là 6868/6869 và 7777/7778 — nếu chỉ có 1 process/gateway và 1 data-manager,
# set cùng port cho _1 và _2 để tránh 502 Bad Gateway do proxy trúng cổng không có service.
#
# Cách chạy (từ thư mục repo):
#   docker compose --env-file .env.host-dev.example up -d nginx
# hoặc copy thành .env.host-dev và chỉnh port cho khớp Run Configuration IntelliJ của bạn.
#
KIRA_GATEWAY_PORT_1=6868
KIRA_GATEWAY_PORT_2=6868
KIRA_DATA_MANAGER_PORT_1=7777
KIRA_DATA_MANAGER_PORT_2=7777
