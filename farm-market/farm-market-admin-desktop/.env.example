# Read at COMPILE time via option_env! -- .env is NOT auto-loaded. Export it in the shell/CI:
#   FARM_ADMIN_URL=https://farm.example.vn npm run build
# Origin only (scheme://host[:port]), no path: "/admin" is joined as an absolute path, so any base path is dropped.
# Never commit a real prod value.
FARM_ADMIN_URL=https://farm.example.vn
