# Copy to .env and change every secret. Never commit the real .env.

# --- MySQL ---
MYSQL_DATABASE=farm_market
MYSQL_USER=farm_market
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password

# --- Backend (farm-market-service) ---
# At least 32 characters.
JWT_SECRET=development-secret-must-have-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:4201
# Only true for local development; must be false in production.
APP_SEED_DEVELOPMENT_USERS=true
# First admin for a fresh install: both required (password >= 12 chars). Created only when no admin exists; remove the
# password from the environment afterwards. The admin enrolls TOTP at first login. Ignored if either value is empty or an
# admin already exists.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_BOOTSTRAP_ADMIN_NAME=
# Public URL of the web app (links in emails) and password reset token lifetime. SPRING_PROFILES_ACTIVE=dev logs the
# reset link (no mail sender yet); other profiles do not log it. The reset link is APP_PUBLIC_URL + /reset-password#token=
# (the UI uses hash routing).
APP_PUBLIC_URL=http://localhost:4201
APP_PASSWORD_RESET_TTL=PT30M

# --- Product/review images ---
# Folder for uploaded images (local disk, mount a persistent volume; one backend instance only). docker compose
# overrides this to /data/uploads (the volume mount), so it only applies to running the service outside compose.
APP_UPLOAD_DIR=./uploads
# Optional origin prepended to returned image URLs. Leave empty: URLs stay relative (/api/v1/files/...), which works
# because both the UI nginx and the dev proxy forward /api to the service. If set it must be https://host[:port]
# (http is rejected by the image URL validator).
APP_MEDIA_PUBLIC_BASE_URL=

# --- Bank transfer via public VietQR image (no gateway account, no API key) ---
# Shop bank account shown on BANK_TRANSFER orders. QR appears only when bank code/BIN, account no. and name are all set.
# Bank code/BIN, e.g. 970436 (or short code such as vcb). VIETQR_BANK_BIN wins over BANK_CODE.
VIETQR_BANK_BIN=
BANK_CODE=
BANK_ACCOUNT_NO=
BANK_ACCOUNT_NAME=
# Optional friendly bank name shown to the customer.
BANK_NAME=

# --- Online payment gateways (not integrated: EWALLET / CARD are confirmed manually by staff) ---
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# --- Maps / shipping (nearest-branch lookup, delivery fee) ---
MAPBOX_ACCESS_TOKEN=
