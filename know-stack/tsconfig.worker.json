{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"],
    "tsBuildInfoFile": "./node_modules/.tmp/worker.tsbuildinfo"
  },
  "include": ["worker", "vite.config.ts", "vitest.config.ts", "drizzle.config.ts"]
}
