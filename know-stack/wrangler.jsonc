{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "know-stack",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "knowstack", "database_id": "b512e67a-3330-484e-8c25-0217f7bad8d7", "migrations_dir": "migrations" }
  ],
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "TRACK_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ]
}
