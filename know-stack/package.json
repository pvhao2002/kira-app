{
  "name": "know-stack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply knowstack --local",
    "db:seed:local": "wrangler d1 execute knowstack --local --file seed/seed.sql",
    "deploy": "vite build && wrangler deploy"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.66.0",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
