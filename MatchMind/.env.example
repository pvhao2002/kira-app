# Copy to .env and replace every CHANGE_ME value. Never commit .env.

# PostgreSQL
DB_USERNAME=matchmind
DB_PASSWORD=CHANGE_ME_strong_db_password
DB_PORT=5433

# JWT signing secret: at least 32 random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=CHANGE_ME_at_least_32_bytes_of_random_data
JWT_TTL=PT8H
# Hard limit from the password sign-in, however often the token is refreshed.
JWT_MAX_SESSION=PT24H

# Legacy shared agent key (optional, 32+ characters when set), e.g. `openssl rand -base64 36`. Agents should use
# per-provider keys issued on the Providers screen instead. While this is set, the shared key still works: the agent
# sends X-Provider and an unknown provider is created automatically (API Logs mark these calls legacyKey=true).
# Cut-over: unset it on 2026-12-31 and restart. Empty turns the legacy path off; the API still starts.
EXTERNAL_API_KEY=
# Optional: link of the Google Sheet that agents append unsent requests to (docs/google-sheet/MatchMind.gs sends them).
# The admin copy of the prompts fills it in; empty means agents skip the sheet.
MATCHMIND_SHEET_URL=
# Optional: public origin of this stack, e.g. https://match.example.org. Prompts copied for agents name it as the
# API URL. Empty means the origin the browser used, which is wrong behind a TLS proxy that nginx sees as http.
PUBLIC_BASE_URL=

# First administrator. Used only when the users table is empty (first start). Remove it afterwards.
MATCHMIND_ADMIN_USERNAME=admin
MATCHMIND_ADMIN_PASSWORD=CHANGE_ME_min_10_chars

# Browser origins allowed to call the API directly. The bundled web container is same-origin and needs none.
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Proxies whose X-Forwarded-For is trusted for client IPs (login rate limit, audit log). Default: Docker networks.
TRUSTED_PROXIES=172.16.0.0/12
# Swagger UI at /swagger/ (admins only through the web container).
SWAGGER_ENABLED=true

API_PORT=8090
WEB_PORT=8088

# Optional log monitoring (Loki + Alloy + Grafana at /monitor/, admins only). Empty leaves it off.
COMPOSE_PROFILES=

