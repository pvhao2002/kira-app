# Same names and defaults as kira-queue application.yml. Never commit real secrets.
# `npm start` loads ./.env if present (node --env-file-if-exists); Docker/compose pass these as real env vars.

# MySQL (primary)
DB_PRIMARY_HOST=localhost
DB_PRIMARY_PORT=3310
DB_NAME=kira
DB_APP_USER=kira_user
DB_APP_PASSWORD=kira_password

# RabbitMQ
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USERNAME=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/

# Consumers (each falls back to KIRA_QUEUE_CONSUMER_ENABLED, default false)
KIRA_QUEUE_CONSUMER_ENABLED=false
# KIRA_QUEUE_CONSUMER_DATE_ENABLED=
# KIRA_QUEUE_CONSUMER_EVENT_ENABLED=
# KIRA_QUEUE_CONSUMER_PREDICT_ENABLED=
# KIRA_QUEUE_CONSUMER_SETTLE_ENABLED=
KIRA_QUEUE_PREDICT_CONCURRENCY=8

# Browser extension bearer token: SHA-256 hex of the token. Empty = /queue/ext/* always 401.
KIRA_EXTENSION_TOKEN_SHA256=

# Browser (patchright)
PLAYWRIGHT_HEADLESS=true
# Chrome channel; empty falls back to "chrome" (patchright works best with real Chrome)
PLAYWRIGHT_CHANNEL=
AISCORE_BROWSER_TIMEOUT_MS=30000
AISCORE_VERIFICATION_TIMEOUT_MS=120000
AISCORE_ACCEPT_LANGUAGE=en-US,en;q=0.9
AISCORE_PROFILE_BASE_DIR=.playwright
# Profile dir is {AISCORE_PROFILE_BASE_DIR}/{id}/{lane}; id = PLAYWRIGHT_INSTANCE_ID, else KIRA_CRAWL_INSTANCE_ID, else port2323
PLAYWRIGHT_INSTANCE_ID=
KIRA_CRAWL_INSTANCE_ID=

# Logging: ${LOG_DIR}/kira-queue-v2-${INSTANCE_ID}.log
LOG_DIR=../logs
INSTANCE_ID=local

# Remote browser display (Xvfb + x11vnc + noVNC), used by docker-entrypoint.sh
KIRA_QUEUE_REMOTE_DISPLAY_ENABLED=false
KIRA_QUEUE_NOVNC_PORT=6081
KIRA_QUEUE_VNC_PORT=5901
KIRA_QUEUE_VNC_PASSWORD_FILE=/run/secrets/kira_queue_vnc_password
