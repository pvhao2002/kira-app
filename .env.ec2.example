# =============================================================================
# Production env chung cho toàn bộ stack (EC2 / Portainer)
# Setup:  cp .env.ec2.example .env.ec2  →  điền giá trị thật
# Chạy:    docker compose --env-file .env.ec2 -f docker-compose.prod.yml up -d
# Portainer (RabbitMQ + kira-producer): docs/portainer-ec2-setup.md
# =============================================================================

# --- Database ---
DB_NAME=kira
DB_APP_USER=your_db_user
DB_APP_PASSWORD=your_db_password
DB_PRIMARY_HOST=your-db-host
DB_PRIMARY_PORT=3306
DB_REPLICA_HOST=your-db-host
DB_REPLICA_PORT=3306

# --- RabbitMQ ---
RABBIT_HOST=your-rabbit-host
RABBIT_PORT=5672
RABBIT_USERNAME=your_rabbit_user
RABBIT_PASSWORD=your_rabbit_password
RABBIT_VHOST=your_vhost

# --- Gateway ---
APP_DATA_MANAGER_BASE_URL=http://kira-data-manager:7777/data
APP_KIRA_PRODUCER_BASE_URL=http://host.docker.internal:2311
APP_SECURITY_COOKIE_SECURE=true
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://kira.id.vn,https://www.kira.id.vn
APP_SECURITY_JWT_SECRET=change-me-in-production-change-me-in-production

# --- Crawl ---
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TEST_API_ENABLED=false
APP_GATEWAY_BASE_URL=http://kira-gateway:6868/gateway
AISCORE_COOKIE=
