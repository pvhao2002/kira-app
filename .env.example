# =============================================================================
# Kira stack — biến dùng bởi docker-compose.yml (Compose tự đọc .env ở thư mục gốc).
# Sao chép:  copy .env.example .env   rồi chỉnh giá trị.
# File .env đã nằm trong .gitignore — không commit mật khẩu production.
# =============================================================================

# --- Compose (tùy chọn) ---
# Bật profile "apps" mặc định (kira-ui, gateway, data-manager, producer):
# COMPOSE_PROFILES=apps

# --- MySQL (single instance) ---
DB_PORT_PUBLISHED=3310
# Legacy alias (optional): DB_PRIMARY_PORT_PUBLISHED=3310
DB_ROOT_PASSWORD=1234
DB_NAME=kira
DB_APP_USER=kira_user
DB_APP_PASSWORD=kira_password

# --- RabbitMQ (volume paths; user/pass trong compose hiện là guest/guest cố định) ---
RABBITMQ_DATA_DIR=./data/rabbitmq
RABBITMQ_LOG_DIR=./data/rabbitmq-logs

# --- Profile apps: published ports ---
KIRA_UI_PORT_PUBLISHED=4200
KIRA_GATEWAY_PORT_1=6868
KIRA_GATEWAY_PORT_2=6869
KIRA_DATA_MANAGER_PORT_1=7777
KIRA_DATA_MANAGER_PORT_2=7778
KIRA_PRODUCER_PORT_PUBLISHED=2311

# --- kira-gateway (1 & 2) ---
APP_DATA_MANAGER_BASE_URL=http://nginx/data
APP_KIRA_PRODUCER_BASE_URL=http://kira-producer:2311
APP_SECURITY_COOKIE_SECURE=false

# --- kira-producer ---
KIRA_PRODUCER_CRAWL_SCHEDULE_ENABLED=true
# KIRA_PRODUCER_CRAWL_SCHEDULE_DATE_ENABLED=false
# KIRA_PRODUCER_CRAWL_SCHEDULE_EVENT_ENABLED=false
KIRA_PRODUCER_SOCCER_TEAM_RECENT_STAT_ENABLED=true
# KIRA_PRODUCER_SOCCER_TEAM_RECENT_STAT_CRON=0 30 2 * * *

# --- nginx (reverse proxy; upstream mặc định = host / IntelliJ) ---
# Windows: để 8800 nếu port 80 bị HTTP.sys/IIS giữ.
NGINX_PORT=8800
KIRA_SERVICE_HOST=host.docker.internal
KIRA_SERVICE_PORT=2308
KIRA_QUEUE_HOST=host.docker.internal
KIRA_QUEUE_PORT=2323
KIRA_GATEWAY_HOST_1=host.docker.internal
KIRA_GATEWAY_PORT_1=6868
KIRA_GATEWAY_HOST_2=host.docker.internal
KIRA_GATEWAY_PORT_2=6869
KIRA_DATA_MANAGER_HOST_1=host.docker.internal
KIRA_DATA_MANAGER_PORT_1=7777
KIRA_DATA_MANAGER_HOST_2=host.docker.internal
KIRA_DATA_MANAGER_PORT_2=7778
KIRA_TOOL_SERVICE_HOST=host.docker.internal
KIRA_TOOL_SERVICE_PORT=1406
KIRA_UI_HOST=host.docker.internal
KIRA_UI_PORT=4200
NGINX_SERVER_NAME="localhost kira.local"

# --- Chạy toàn bộ app trong Docker (thay host bằng tên service) ---
# Xem .env.compose-apps.example — có thể merge hoặc dùng:
#   docker compose --env-file .env --env-file .env.compose-apps.local up -d

# --- RabbitMQ (compose: cổng / mật khẩu cố định trong YAML) ---
# AMQP: 5672, Management UI: 15672 (user/pass: guest/guest)

# --- Cloudflare R2 (kira-queue logo upload) ---
# Chạy: CLOUDFLARE_API_TOKEN=... ./scripts/setup-r2-env.sh
# Account/bucket mặc định từ MCP Cloudflare (có thể override).
CLOUDFLARE_ACCOUNT_ID=451bc9b2fc048e958bffb2e78b9f8ca9
R2_ENDPOINT=https://451bc9b2fc048e958bffb2e78b9f8ca9.r2.cloudflarestorage.com
R2_BUCKET=kira-r2
# R2_ACCESS_KEY=          # từ dashboard hoặc setup-r2-env.sh
# R2_SECRET_KEY=
# R2_PUBLIC_BASE_URL=      # https://<bucket>.<account_id>.r2.dev (setup script bật public dev URL)
R2_QUOTA_MAX_STORAGE_BYTES=10737418240
R2_QUOTA_MAX_CLASS_A_OPS_MONTH=1000000
R2_QUOTA_WARN_AT_PERCENT=90
