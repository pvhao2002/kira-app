server {
  listen 80;
  server_name _;

  # Fast health endpoint for checks.
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # kira-service (Spring context-path: /api)
  location /api/ {
    proxy_pass http://kira_service_upstream;
  }

  # kira-queue (Spring context-path: /queue)
  location /queue/ {
    proxy_pass http://kira_queue_upstream;
  }

  # kira-gateway (Spring context-path: /gateway)
  location = /gateway {
    return 301 /gateway/;
  }

  location /gateway/ {
    proxy_pass http://kira_gateway_upstream;
    proxy_connect_timeout 5s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    # Retry peers on connect/timeout/5xx so a dead :8889/:8890 does not surface as 502 when :8888 is up.
    proxy_next_upstream error timeout http_502 http_503 http_504;
    proxy_next_upstream_tries 3;
  }

  # tool-service (Spring context-path: /tool-service)
  location /tool-service/ {
    proxy_pass http://kira_tool_service_upstream;
  }
}

upstream kira_service_upstream {
  server ${KIRA_SERVICE_HOST}:${KIRA_SERVICE_PORT};
  keepalive 32;
}

upstream kira_queue_upstream {
  server ${KIRA_QUEUE_HOST}:${KIRA_QUEUE_PORT};
  keepalive 32;
}

# Primary = KIRA_GATEWAY_*_1 (traffic goes here whenever it is up).
# *_2 / *_3 are backup only — use when you run a single gateway on PORT_1 and nothing on PORT_2/3
# (avoids least_conn sending requests to dead peers). For equal load across 3 instances, remove "backup".
upstream kira_gateway_upstream {
  server ${KIRA_GATEWAY_HOST_1}:${KIRA_GATEWAY_PORT_1} max_fails=2 fail_timeout=10s;
  server ${KIRA_GATEWAY_HOST_2}:${KIRA_GATEWAY_PORT_2} max_fails=2 fail_timeout=10s;
  server ${KIRA_GATEWAY_HOST_3}:${KIRA_GATEWAY_PORT_3} max_fails=2 fail_timeout=10s;
  keepalive 32;
}

upstream kira_tool_service_upstream {
  server ${KIRA_TOOL_SERVICE_HOST}:${KIRA_TOOL_SERVICE_PORT};
  keepalive 32;
}
