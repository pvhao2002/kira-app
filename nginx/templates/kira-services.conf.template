server {
  listen 80;
  server_name ${NGINX_SERVER_NAME};

  # Fast health endpoint for checks.
  location = /health {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # kira-service (Spring context-path: /api)
  location /api/ {
    proxy_pass http://kira_service_upstream;
  }

  # kira-queue (Spring context-path: /queue)
  location /queue/ {
    proxy_pass http://kira_queue_upstream;
  }

  # kira-gateway (Spring context-path: /gateway)
  location = /gateway {
    return 301 /gateway/;
  }

  location /gateway/ {
    proxy_pass http://kira_gateway_upstream;
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    # Retry only on TCP errors / timeouts — retrying 502 overloads backends under load.
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;
  }

  # kira-data-manager (Spring context-path: /data)
  location = /data {
    return 301 /data/;
  }

  location /data/ {
    proxy_pass http://kira_data_manager_upstream;
    proxy_connect_timeout 10s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_next_upstream error timeout;
    proxy_next_upstream_tries 2;
  }

  # tool-service (Spring context-path: /tool-service)
  location /tool-service/ {
    proxy_pass http://kira_tool_service_upstream;
  }

  # kira-ui (ng serve on host; must be last so /api, /gateway, etc. stay on backends)
  location / {
    proxy_pass http://kira_ui_upstream;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_buffering off;
    proxy_read_timeout 86400s;
  }
}

upstream kira_service_upstream {
  server ${KIRA_SERVICE_HOST}:${KIRA_SERVICE_PORT};
  keepalive 32;
}

upstream kira_queue_upstream {
  server ${KIRA_QUEUE_HOST}:${KIRA_QUEUE_PORT};
  keepalive 32;
}

upstream kira_gateway_upstream {
  # max_fails=0: never mark a peer "temporarily disabled" — safe when both
  # entries point to the same port (single-instance dev via nginx/.env).
  server ${KIRA_GATEWAY_HOST_1}:${KIRA_GATEWAY_PORT_1} max_fails=0;
  server ${KIRA_GATEWAY_HOST_2}:${KIRA_GATEWAY_PORT_2} max_fails=0;
  keepalive 32;
}

upstream kira_data_manager_upstream {
  # max_fails=0: never mark a peer "temporarily disabled" — safe when both
  # entries point to the same port (single-instance dev via nginx/.env).
  server ${KIRA_DATA_MANAGER_HOST_1}:${KIRA_DATA_MANAGER_PORT_1} max_fails=0;
  server ${KIRA_DATA_MANAGER_HOST_2}:${KIRA_DATA_MANAGER_PORT_2} max_fails=0;
  keepalive 32;
}

upstream kira_tool_service_upstream {
  server ${KIRA_TOOL_SERVICE_HOST}:${KIRA_TOOL_SERVICE_PORT};
  keepalive 32;
}

upstream kira_ui_upstream {
  server ${KIRA_UI_HOST}:${KIRA_UI_PORT};
  keepalive 32;
}
