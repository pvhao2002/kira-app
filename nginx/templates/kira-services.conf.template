server {
  listen 80;
  server_name _;

  # Fast health endpoint for checks.
  location = /healthz {
    access_log off;
    add_header Content-Type text/plain;
    return 200 "ok\n";
  }

  # kira-service (Spring context-path: /api)
  location /api/ {
    proxy_pass http://kira_service_upstream;
  }

  # kira-queue (Spring context-path: /queue)
  location /queue/ {
    proxy_pass http://kira_queue_upstream;
  }

  # kira-gateway (Spring context-path: /gateway)
  location = /gateway {
    return 301 /gateway/;
  }

  location /gateway/ {
    proxy_pass http://kira_gateway_upstream;
    proxy_connect_timeout 5s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
  }

  # kira-data-manager (Spring context-path: /data)
  location = /data {
    return 301 /data/;
  }

  location /data/ {
    proxy_pass http://kira_data_manager_upstream;
    proxy_connect_timeout 5s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
  }

  # tool-service (Spring context-path: /tool-service)
  location /tool-service/ {
    proxy_pass http://kira_tool_service_upstream;
  }
}

upstream kira_service_upstream {
  server ${KIRA_SERVICE_HOST}:${KIRA_SERVICE_PORT};
  keepalive 32;
}

upstream kira_queue_upstream {
  server ${KIRA_QUEUE_HOST}:${KIRA_QUEUE_PORT};
  keepalive 32;
}

upstream kira_gateway_upstream {
  server ${KIRA_GATEWAY_HOST}:${KIRA_GATEWAY_PORT} max_fails=2 fail_timeout=10s;
  keepalive 32;
}

upstream kira_data_manager_upstream {
  server ${KIRA_DATA_MANAGER_HOST}:${KIRA_DATA_MANAGER_PORT} max_fails=2 fail_timeout=10s;
  keepalive 32;
}

upstream kira_tool_service_upstream {
  server ${KIRA_TOOL_SERVICE_HOST}:${KIRA_TOOL_SERVICE_PORT};
  keepalive 32;
}
