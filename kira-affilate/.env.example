# Copy to .env (git-ignored) and fill in. Never commit real values.

# --- database ---
DB_URL=jdbc:mysql://localhost:3309/kira_affiliate?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=

# --- auth ---
# >= 32 random characters: openssl rand -base64 48
JWT_SECRET=
# true behind HTTPS (production)
REFRESH_COOKIE_SECURE=false
# Exact origins of the UI, comma separated
CORS_ALLOWED_ORIGINS=http://localhost:4202
# CIDRs of reverse proxies whose X-Forwarded-For is trusted (login rate limiting)
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Shopee ---
# Base64 of 32 random bytes: openssl rand -base64 32. Encrypts users' Shopee secrets at rest.
# Losing or changing it makes stored secrets unreadable (users re-enter them).
SHOPEE_CREDENTIAL_ENCRYPTION_KEY=
SHOPEE_SYNC_ENABLED=true
SHOPEE_SYNC_CRON=0 15 * * * *
SHOPEE_SYNC_WINDOW_DAYS=30

# --- optional: live Shopee API test (ShopeeLiveIT). Per-user credentials are entered in the UI, not here. ---
SHOPEE_APP_ID=
SHOPEE_SECRET=
