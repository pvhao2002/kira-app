# Read at COMPILE time via option_env! -- .env is NOT auto-loaded. Export it in the shell/CI:
#   PowerShell: $env:KIRA_BANK_URL='https://bank.example.vn'; npm run dev
#   POSIX:      KIRA_BANK_URL=https://bank.example.vn npm run dev
# Unset -> fallback-only app, no error. Never commit a real prod value.
KIRA_BANK_URL=https://bank.example.vn
