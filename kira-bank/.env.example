MYSQL_DATABASE=kira_bank
MYSQL_USER=kira_bank
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:4200
AI_BASE_URL=
AI_API_KEY=

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kira-bank-attachments
R2_PUBLIC_URL=

# Cloudflare Workers AI. Use a separate token with Workers AI permission.
AI_ENABLED=false
AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
AI_MODEL=@cf/moonshotai/kimi-k2.7-code
AI_BATCH_SIZE=3
AI_MAX_ATTEMPTS=3
AI_RETRY_DELAY=PT3H
AI_PROCESSING_TIMEOUT=PT30M
AI_JOB_CRON=0 0 */3 * * *
AI_JOB_TIME_ZONE=Asia/Bangkok
