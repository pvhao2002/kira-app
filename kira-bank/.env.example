MYSQL_DATABASE=kira_bank
MYSQL_USER=kira_bank
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ALLOWED_ORIGINS=http://localhost:4200
# Mapbox server-side token for lodging geocoding and driving distance
MAPBOX_ACCESS_TOKEN=

# Cloudflare provider credentials, AI model and R2 bucket are managed in the Admin UI.
# Base64-encoded 32-byte AES key used only to encrypt those dynamic credentials.
AI_CREDENTIAL_ENCRYPTION_KEY=
# Password vault envelope-encryption key ring. Example: v1:<Base64 encoded 32-byte key>
PASSWORD_VAULT_ENCRYPTION_KEYS=
PASSWORD_VAULT_ACTIVE_KEY_ID=
AI_ACCOUNT_RATE_LIMIT_COOLDOWN=PT1M
AI_BATCH_SIZE=3
AI_MAX_ATTEMPTS=3
AI_RETRY_DELAY=PT3H
AI_PROCESSING_TIMEOUT=PT30M
AI_JOB_CRON=0 0 */3 * * *
AI_JOB_TIME_ZONE=Asia/Bangkok
INVESTMENT_IMPORT_TIME_ZONE=Asia/Ho_Chi_Minh
INVESTMENT_IMPORT_RETENTION_CRON=0 20 2 * * *

# Monthly credit-card statement reminder. Only prepares the current month.
CARD_STATEMENT_JOB_CRON=0 5 0 * * *
CARD_STATEMENT_JOB_TIME_ZONE=Asia/Bangkok
