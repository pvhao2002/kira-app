{
  "expo": {
    "name": "Kira Life",
    "slug": "kira-life-mobile",
    "version": "1.0.0",
    "scheme": "kiralifedemo",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.kira.life",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Kira Life dùng Face ID để xác thực nhanh vào ứng dụng."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kira Life cần quyền truy cập ảnh để chọn chứng từ giao dịch.",
          "cameraPermission": "Kira Life cần quyền camera để chụp chứng từ giao dịch.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
