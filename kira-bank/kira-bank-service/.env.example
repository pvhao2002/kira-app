# Optional global model override for Cloudflare Workers AI.
# Leave blank to use each verified Cloudflare account's configured model.
AI_MODEL=@cf/moonshotai/kimi-k2.7-code

# Required for admin-managed encrypted Cloudflare credentials.
# AI_CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Required for encrypted investment-account passwords. Use a separate Base64-encoded 32-byte AES key.
# INVESTMENT_CREDENTIAL_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Business timezone used to filter and group investment transactions by date.
# INVESTMENT_IMPORT_TIME_ZONE=Asia/Ho_Chi_Minh
