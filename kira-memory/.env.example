# Copy to .env (never commit it). Every value below is read by kira-memory-service.
DB_PASSWORD=change-me
DB_URL=jdbc:mysql://localhost:3316/kira_memory?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
# >= 32 random chars each: openssl rand -base64 48
JWT_SECRET=
MEDIA_URL_SECRET=
# true behind HTTPS (production)
COOKIE_SECURE=false

# Hugging Face (default storage): a PRIVATE dataset repo and a write token
HF_DATASET_REPO=your-user/your-private-dataset
HF_TOKEN=

# Cloudflare R2. Local dev: the r2-local S3Mock container from docker-compose.yml
R2_ENDPOINT=http://localhost:9096
R2_BUCKET=memories
R2_ACCESS_KEY_ID=local
R2_SECRET_ACCESS_KEY=local
R2_REGION=us-east-1
# Production R2: R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and R2_REGION=auto
