# Shape reference only. Never commit real values.
# Node does not load this file by itself: export the values into the environment
# (systemd EnvironmentFile=, or `node --env-file=.env src/server.ts` locally).

# Set to false only for plain-http local development.
TOOL_COOKIE_SECURE=true

TOOL_PORT=1407
TOOL_DATA_DIR=./data
TOOL_STORAGE_DIR=./storage
TOOL_RETENTION_DAYS=7
TOOL_WORKERS=2
TOOL_JOB_TIMEOUT=PT10M
TOOL_HEADLESS=true
# native: trust X-Forwarded-For only from loopback/private proxies (nginx). none: no reverse proxy.
TOOL_FORWARD_HEADERS=native
